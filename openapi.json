            "title": "Inputs",
            "type": "object"
          },
          "max_particles": {
            "anyOf": [
              {
                "maximum": 200000.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Particles"
          },
          "outputs": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Outputs",
            "type": "array"
          },
          "screen": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Screen"
          },
          "smooth_images_sigma_px": {
            "anyOf": [
              {
                "maximum": 50.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Smooth Images Sigma Px"
          }
        },
        "title": "EvaluateV1Request",
        "type": "object"
      },
      "EvaluateV1Response": {
