            "title": "Outputs",
            "type": "object"
          },
          "timestamp": {
            "title": "Timestamp",
            "type": "number"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "model",
          "version",
          "timestamp",
          "frame_index",
          "inputs",
