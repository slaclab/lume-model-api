            "type": "number"
          },
          "min": {
            "title": "Min",
            "type": "number"
          },
          "range_source": {
            "title": "Range Source",
            "type": "string"
          },
          "unit": {
            "default": "",
            "title": "Unit",
            "type": "string"
          }
        },
        "required": [
          "id",
          "default",
          "min",
          "max",
          "range_source"
