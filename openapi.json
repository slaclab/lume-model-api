{
  "components": {
    "schemas": {
      "ArrayOutput": {
        "description": "An N-dimensional array, base64-encoded. 2-D arrays are usually screen images.",
        "properties": {
          "data_b64": {
            "description": "Base64 of little-endian float32 values, row-major.",
            "title": "Data B64",
            "type": "string"
          },
          "dtype": {
            "default": "float32",
            "description": "Always `float32`.",
            "title": "Dtype",
            "type": "string"
          },
          "kind": {
            "const": "array",
            "title": "Kind",
            "type": "string"
          },
          "shape": {
            "description": "Array shape after any image downsampling. Reshape `data_b64` to this.",
            "items": {
              "type": "integer"
            },
            "title": "Shape",
            "type": "array"
          },
          "unit": {
            "default": "",
            "description": "Unit, as declared by the model.",
            "title": "Unit",
            "type": "string"
          },
          "variable_class": {
            "default": "",
            "description": "lume variable class. Finer than `kind`. Empty when unknown.",
            "title": "Variable Class",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "shape",
          "data_b64"
        ],
        "title": "ArrayOutput",
        "type": "object"
      },
      "ConfigResponse": {
        "description": "Everything a model publishes: its inputs, outputs and screens.",
        "properties": {
          "description": {
            "default": "",
            "description": "Short description from the model.",
            "title": "Description",
            "type": "string"
          },
          "inputs": {
            "description": "Inputs that can be set.",
            "items": {
              "$ref": "#/components/schemas/InputInfo"
            },
            "title": "Inputs",
            "type": "array"
          },
          "model": {
            "description": "URL name of the model.",
            "title": "Model",
            "type": "string"
          },
          "outputs": {
            "description": "Outputs that can be requested.",
            "items": {
              "$ref": "#/components/schemas/OutputInfo"
            },
            "title": "Outputs",
            "type": "array"
          },
          "screens": {
            "description": "Diagnostic screens.",
            "items": {
              "$ref": "#/components/schemas/ScreenInfo"
            },
            "title": "Screens",
            "type": "array"
          },
          "version": {
            "description": "Model version.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "model",
          "version",
          "inputs",
          "outputs",
          "screens"
        ],
        "title": "ConfigResponse",
        "type": "object"
      },
      "EvaluateV1Request": {
        "description": "Inputs to set and outputs to return. At least one of `outputs` or `screen` is required.",
        "properties": {
          "inputs": {
            "additionalProperties": {
              "type": "number"
            },
            "default": {},
            "description": "Input id to value. Omitted inputs use their design value, so `{}` evaluates the design machine. Values must be finite.",
            "title": "Inputs",
            "type": "object"
          },
          "max_particles": {
            "anyOf": [
              {
                "maximum": 200000.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Maximum particles per particle output. Defaults to 3000.",
            "title": "Max Particles"
          },
          "outputs": {
            "default": [],
            "description": "Output ids to return.",
            "items": {
              "type": "string"
            },
            "title": "Outputs",
            "type": "array"
          },
          "screen": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Screen key. Adds that screen's particle output and its image, when it has one, to `outputs`.",
            "title": "Screen"
          },
          "smooth_images_sigma_px": {
            "anyOf": [
              {
                "maximum": 50.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Gaussian blur width in pixels, applied to every 2-D array output. Off by default. Intensities are not renormalized.",
            "title": "Smooth Images Sigma Px"
          }
        },
        "title": "EvaluateV1Request",
        "type": "object"
      },
      "EvaluateV1Response": {
        "description": "One model evaluation. Also the body of each live stream `frame` event.",
        "properties": {
          "frame_index": {
            "description": "0 on the evaluate route. On the live stream, a counter that only increases, with gaps.",
            "title": "Frame Index",
            "type": "integer"
          },
          "input_sources": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "description": "Same keys as `inputs`. `\"request\"` when sent in the request, `\"baseline\"` when filled in from the design value, `\"live\"` when read from the machine (live stream only).",
            "title": "Input Sources",
            "type": "object"
          },
          "inputs": {
            "additionalProperties": {
              "type": "number"
            },
            "description": "Every input value the model ran with, including the filled-in defaults.",
            "title": "Inputs",
            "type": "object"
          },
          "model": {
            "description": "URL name of the model.",
            "title": "Model",
            "type": "string"
          },
          "outputs": {
            "additionalProperties": {
              "discriminator": {
                "mapping": {
                  "array": "#/components/schemas/ArrayOutput",
                  "particles": "#/components/schemas/ParticlesOutput",
                  "scalar": "#/components/schemas/ScalarOutput",
                  "value": "#/components/schemas/ValueOutput"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/ScalarOutput"
                },
                {
                  "$ref": "#/components/schemas/ArrayOutput"
                },
                {
                  "$ref": "#/components/schemas/ParticlesOutput"
                },
                {
                  "$ref": "#/components/schemas/ValueOutput"
                }
              ]
            },
            "description": "Output id to payload. Every requested id is present. Switch on `kind`.",
            "title": "Outputs",
            "type": "object"
          },
          "timestamp": {
            "description": "Unix time in seconds when the result was serialized.",
            "title": "Timestamp",
            "type": "number"
          },
          "version": {
            "description": "Model version.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "model",
          "version",
          "timestamp",
          "frame_index",
          "inputs",
          "outputs"
        ],
        "title": "EvaluateV1Response",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InputInfo": {
        "description": "A writable scalar input that can be sent in an evaluate request.",
        "properties": {
          "alias_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Always null on an input. See `OutputInfo.alias_of`.",
            "title": "Alias Of"
          },
          "constant": {
            "default": false,
            "description": "True when `min` equals `max`. The input is fixed and never set.",
            "title": "Constant",
            "type": "boolean"
          },
          "default": {
            "description": "Design value. Used when a request omits this input.",
            "title": "Default",
            "type": "number"
          },
          "id": {
            "description": "Input id, used as a key in evaluate `inputs`.",
            "title": "Id",
            "type": "string"
          },
          "max": {
            "description": "Upper limit.",
            "title": "Max",
            "type": "number"
          },
          "min": {
            "description": "Lower limit.",
            "title": "Min",
            "type": "number"
          },
          "range_source": {
            "description": "`\"model\"` when the model declared the range. `\"derived\"` when the service estimated it from the default because the model declared none.",
            "title": "Range Source",
            "type": "string"
          },
          "unit": {
            "default": "",
            "description": "Unit, as declared by the model.",
            "title": "Unit",
            "type": "string"
          }
        },
        "required": [
          "id",
          "default",
          "min",
          "max",
          "range_source"
        ],
        "title": "InputInfo",
        "type": "object"
      },
      "ModelListEntry": {
        "description": "One model hosted by this deployment.",
        "properties": {
          "description": {
            "default": "",
            "description": "Short description from the model.",
            "title": "Description",
            "type": "string"
          },
          "name": {
            "description": "URL name of the model, used as `{name}` in every other route.",
            "title": "Name",
            "type": "string"
          },
          "version": {
            "description": "Model version. `\"demo\"` or `\"<name> (demo)\"` marks the demo model.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "title": "ModelListEntry",
        "type": "object"
      },
      "OutputInfo": {
        "description": "A value the model can return from an evaluate.",
        "properties": {
          "alias_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when this id controls the same thing as another input, for example a magnet's `BDES` next to its `BCTRL`. Names the input to set instead. This id can still be read, but sending it in `inputs` is a 400.",
            "title": "Alias Of"
          },
          "element_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Beamline element this output belongs to, when declared.",
            "title": "Element Name"
          },
          "id": {
            "description": "Output id, used in evaluate `outputs`.",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "description": "Payload shape this output returns. Matches `kind` in the evaluate response.",
            "enum": [
              "scalar",
              "array",
              "particles",
              "value"
            ],
            "title": "Kind",
            "type": "string"
          },
          "shape": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Array shape, when the model declares one.",
            "title": "Shape"
          },
          "unit": {
            "default": "",
            "description": "Unit, as declared by the model.",
            "title": "Unit",
            "type": "string"
          },
          "variable_class": {
            "default": "",
            "description": "lume variable class, for example `\"ScalarVariable\"` or `\"EnumVariable\"`. Finer than `kind`. Empty when unknown.",
            "title": "Variable Class",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "title": "OutputInfo",
        "type": "object"
      },
      "ParticlesOutput": {
        "description": "A particle distribution, subsampled to `max_particles`.",
        "properties": {
          "coords": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Coordinate name to base64 little-endian float32 array of length `n`. Includes `weight` (per-particle charge).",
            "title": "Coords",
            "type": "object"
          },
          "kind": {
            "const": "particles",
            "title": "Kind",
            "type": "string"
          },
          "n": {
            "description": "Number of particles in each coordinate array.",
            "title": "N",
            "type": "integer"
          },
          "stats": {
            "additionalProperties": {
              "type": "number"
            },
            "description": "Beam statistics, computed on the full beam before subsampling.",
            "title": "Stats",
            "type": "object"
          },
          "stats_units": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Statistic name to unit.",
            "title": "Stats Units",
            "type": "object"
          },
          "units": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Coordinate name to unit, for example `{\"x\": \"m\", \"px\": \"eV/c\"}`.",
            "title": "Units",
            "type": "object"
          },
          "variable_class": {
            "default": "",
            "description": "lume variable class. Finer than `kind`. Empty when unknown.",
            "title": "Variable Class",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "n",
          "units",
          "coords",
          "stats",
          "stats_units"
        ],
        "title": "ParticlesOutput",
        "type": "object"
      },
      "ScalarOutput": {
        "description": "A single number.",
        "properties": {
          "kind": {
            "const": "scalar",
            "title": "Kind",
            "type": "string"
          },
          "unit": {
            "default": "",
            "description": "Unit, as declared by the model.",
            "title": "Unit",
            "type": "string"
          },
          "value": {
            "description": "The value. Null when the model returned NaN or Inf.",
            "title": "Value",
            "type": "number"
          },
          "variable_class": {
            "default": "",
            "description": "lume variable class. Finer than `kind`. Empty when unknown.",
            "title": "Variable Class",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "value"
        ],
        "title": "ScalarOutput",
        "type": "object"
      },
      "ScreenInfo": {
        "description": "A diagnostic location with a particle distribution and, optionally, an image.",
        "properties": {
          "image": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Output id of the screen image. Null when there is none.",
            "title": "Image"
          },
          "key": {
            "description": "Screen name, used as evaluate `screen`.",
            "title": "Key",
            "type": "string"
          },
          "particles": {
            "description": "Output id of the particle distribution at this screen.",
            "title": "Particles",
            "type": "string"
          }
        },
        "required": [
          "key",
          "particles"
        ],
        "title": "ScreenInfo",
        "type": "object"
      },
      "SnapshotResponse": {
        "description": "Current machine values for a model's inputs.",
        "properties": {
          "inputs": {
            "additionalProperties": {
              "type": "number"
            },
            "description": "Input id to value. Unreadable PVs fall back to the design value.",
            "title": "Inputs",
            "type": "object"
          },
          "sources": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "description": "Same keys as `inputs`. `\"live\"` when the value was read from the machine, `\"baseline\"` when the PV could not be read and the design value was used.",
            "title": "Sources",
            "type": "object"
          }
        },
        "required": [
          "inputs"
        ],
        "title": "SnapshotResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValueOutput": {
        "description": "Anything that isn't a number, an array or a beam, such as an enum, a string or a flag.",
        "properties": {
          "kind": {
            "const": "value",
            "title": "Kind",
            "type": "string"
          },
          "value": {
            "description": "Any JSON value.",
            "title": "Value"
          },
          "variable_class": {
            "default": "",
            "description": "lume variable class. The only way to tell an enum from a string here.",
            "title": "Variable Class",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "title": "ValueOutput",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "LUME model API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/models": {
      "get": {
        "description": "Every model hosted here, sorted by name.\n\n`name` goes into the path of every other route. A model whose pool has died is still\nlisted, so this route is not a health check.",
        "operationId": "list_models_api_v1_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ModelListEntry"
                  },
                  "title": "Response List Models Api V1 Models Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List hosted models",
        "tags": [
          "model-api"
        ]
      }
    },
    "/api/v1/models/{name}/config": {
      "get": {
        "description": "The model's inputs, outputs and screens, read from the model itself.\n\nUse the ids from here in evaluate and the live stream. The response can change when the\ndeployment's model changes, so read it at startup instead of hard-coding ids.",
        "operationId": "get_config_api_v1_models__name__config_get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get a model's inputs, outputs and screens",
        "tags": [
          "model-api"
        ]
      }
    },
    "/api/v1/models/{name}/evaluate": {
      "post": {
        "description": "Run the model and return the requested outputs.\n\nInputs not in the request use their design values, so each call is independent of the\nones before it. Request outputs by id, by `screen`, or both.\n\nArrays and particle coordinates are base64 little-endian float32. In TypeScript, decode\nwith `new Float32Array(Uint8Array.from(atob(s), c => c.charCodeAt(0)).buffer)`. Values\nare in the model's own units, which every payload includes.\n\nErrors:\n\n- 400: no outputs requested, an unknown id, or a value the model rejects\n- 404: unknown model\n- 422: malformed body, including NaN or Inf values\n- 503: pool busy (`Retry-After: 2`, retry) or dead (`Retry-After: 30`, the pod is\n  restarting)",
        "operationId": "evaluate_v1_api_v1_models__name__evaluate_post",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateV1Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluateV1Response"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Evaluate a model",
        "tags": [
          "model-api"
        ]
      }
    },
    "/api/v1/models/{name}/live/stream": {
      "get": {
        "description": "Server-sent events with the model evaluated at the machine's current inputs.\n\nEach `frame` event has the same JSON body as an evaluate response. An `error` event\ncarries `{\"message\": ...}`, and the stream keeps running after it. Requires `screen`,\n`outputs`, or both.\n\nViewers asking for the same set of outputs share one evaluation loop. A new set beyond\nthe deployment's limit is a 503, as is a deployment that doesn't serve live data.",
        "operationId": "live_stream_api_v1_models__name__live_stream_get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "description": "Screen key from the config.",
            "in": "query",
            "name": "screen",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Screen key from the config.",
              "title": "Screen"
            }
          },
          {
            "description": "Comma-separated output ids.",
            "in": "query",
            "name": "outputs",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated output ids.",
              "title": "Outputs"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stream live evaluations",
        "tags": [
          "model-api"
        ]
      }
    },
    "/api/v1/models/{name}/machine-snapshot": {
      "get": {
        "description": "Read the model's inputs from the machine, without evaluating.\n\nA PV that can't be read reports its design value and is marked `\"baseline\"` in `sources`.\nReturns 503 on a deployment that doesn't serve live data.",
        "operationId": "machine_snapshot_api_v1_models__name__machine_snapshot_get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read live input values",
        "tags": [
          "model-api"
        ]
      }
    },
    "/metrics": {
      "get": {
        "description": "Prometheus metrics for this pod.\n\nEvery series has a `model` label, one per hosted model, so sum by pod before averaging\nacross pods.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics"
      }
    }
  }
}
