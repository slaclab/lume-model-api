  "info": {
    "title": "LUME Live Stream Monitor",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/config": {
      "get": {
        "operationId": "get_config_api_config_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Config"
      }
    },
    "/api/evaluate": {
      "post": {
        "operationId": "evaluate_api_evaluate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FrameResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Evaluate"
      }
    },
    "/api/live/stream": {
      "get": {
        "operationId": "live_stream_api_live_stream_get",
        "parameters": [
          {
            "in": "query",
            "name": "screen",
            "required": false,
            "schema": {
              "default": "OTR4",
              "title": "Screen",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Live Stream"
      }
    },
    "/api/machine-snapshot": {
      "get": {
        "operationId": "machine_snapshot_api_machine_snapshot_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Machine Snapshot"
      }
    },
    "/api/v1/evaluate": {
      "post": {
        "description": "Stateless model evaluation for programmatic clients (notebooks, GUIs).\n\n`inputs` is a map of PV name -> engineering-unit control value, overlaid on the\nmodel's design baseline \u2014 send only the knobs you want to change (`{}` = design\nmachine). `GET /api/config` lists the writable inputs with their ranges/defaults.\n\nScalars are always returned. Set `include_image` / `include_distribution` /\n`include_twiss` for the heavier outputs; `max_particles` subsamples the\ndistribution. Large arrays are base64-encoded little-endian float32 \u2014 decode with\ne.g. `numpy.frombuffer(base64.b64decode(s), dtype='<f4')` (image is row-major,\nreshaped to `image.shape`).",
        "operationId": "evaluate_v1_api_v1_evaluate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateV1Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluateV1Response"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run the model on a set of inputs and return beam output",
        "tags": [
          "model-api"
        ]
      }
    },
    "/metrics": {
      "get": {
        "description": "Prometheus scrape endpoint. KEDA autoscales the eval pool on lume_pool_inflight.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics"
      }
    }
  }
}
