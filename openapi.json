  "info": {
    "title": "LUME model API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/models": {
      "get": {
        "description": "Every model served here, sorted by name. Read this instead of hard-coding names.\n\n`name` is the URL segment for that model's other routes, so a dropdown stores `name` and\ninterpolates it. `version` marks a demo deployment.\n\nClient discovery, deliberately not the health check: a pod hosting several models keeps\nlisting the ones that still work even when another model's pool has died. `GET /healthz` is\nwhat the k8s probes target.",
        "operationId": "list_models_api_v1_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ModelListEntry"
                  },
                  "title": "Response List Models Api V1 Models Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List the models this process hosts",
        "tags": [
          "model-api"
        ]
      }
    },
    "/api/v1/models/{name}/config": {
      "get": {
        "description": "Everything a client needs to drive this model: inputs, outputs and screens.\n\nDerived from the model instance itself, so it is accurate for whatever `LUME_MODELS`\nselected. `range_source` says whether an input's min/max came from the model or was\nderived from its default, and `constant` marks an input the model pins to one value.",
        "operationId": "get_config_api_v1_models__name__config_get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Everything a client needs to drive one model",
        "tags": [
          "model-api"
        ]
      }
    },
    "/api/v1/models/{name}/evaluate": {
      "post": {
        "description": "Stateless model evaluation. The one evaluate endpoint for every caller.\n\n`inputs` maps input id to control value, overlaid on the model's baseline, so send only\nthe knobs you want to change (`{}` is the design machine). The effective post-merge\nvalues come back in the response's `inputs`.\n\nAsk for outputs by id in `outputs`, or pass `screen` to get that screen's particle\ndistribution plus its image when it has one. Both may be combined. Every requested id is\npresent in `outputs`, keyed by id, and each value declares its own `kind` and unit.\n\nLarge arrays are base64-encoded little-endian float32, so decode with e.g.\n`numpy.frombuffer(base64.b64decode(s), dtype='<f4')` and reshape to `shape`. Particle\ncoordinates are subsampled to `max_particles` (default 3000, never the full beam).\n\nValues are in the model's own units, declared in the payload. Nothing is converted\nserver-side, so do not hard-code units.",
        "operationId": "evaluate_v1_api_v1_models__name__evaluate_post",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluateV1Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluateV1Response"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run one model on a set of inputs and return the requested outputs",
        "tags": [
          "model-api"
        ]
      }
    },
    "/api/v1/models/{name}/live/stream": {
      "get": {
        "description": "SSE `frame` events with the same body as this model's evaluate route.\n\nRequires `screen` or `outputs` (or both). Loops are shared by output set within a model, so\nmany viewers of the same set cost one evaluate loop. Errors arrive as an `error` event and\nthe loop keeps running.",
        "operationId": "live_stream_api_v1_models__name__live_stream_get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "screen",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Screen"
            }
          },
          {
            "description": "Comma-separated output ids",
            "in": "query",
            "name": "outputs",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated output ids",
              "title": "Outputs"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Live Stream",
        "tags": [
          "model-api"
        ]
      }
    },
    "/api/v1/models/{name}/machine-snapshot": {
      "get": {
        "description": "The live input values, read-only. Ids with no live value report their baseline.\n\n`sources` says which is which, per id: \"live\" for a value read off the machine on this call,\n\"baseline\" for one the merge filled in from the model's design value because the PV could not\nbe read. Without it the two are the same number on the wire.",
        "operationId": "machine_snapshot_api_v1_models__name__machine_snapshot_get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "The live input values for one model, read-only",
        "tags": [
          "model-api"
        ]
      }
    },
    "/metrics": {
      "get": {
        "description": "Prometheus scrape endpoint. KEDA autoscales the eval pool on lume_pool_inflight.\n\nEvery series carries a `model` label, one per hosted model, so an aggregate has to sum by\npod before averaging. See deploy/kubernetes/keda-scaledobject.yaml.",
        "operationId": "metrics_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Metrics"
      }
    }
  }
}
